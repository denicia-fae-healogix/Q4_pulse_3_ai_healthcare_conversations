# Keep respondent-level data out of this public repo.
# Only data/public/ (counts and averages) is meant to be committed.
*.csv
*.xlsx
*.xls
*.sav
*.rds
*.RData
*.Rhistory
data/*
!data/public/
!data/public/**

# Knit output and local clutter
scripts/output/
*.html.tmp
.Rproj.user/
__pycache__/
.ipynb_checkpoints/
.DS_Store
Thumbs.db
desktop.ini

# The codebook workbook holds definitions only, so it can be committed
!codebook/*.xlsx
